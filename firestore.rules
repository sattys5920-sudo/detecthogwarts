rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 리더보드: 누구나 읽을 수 있고, 형식이 올바른 결과만 새로 추가할 수 있습니다.
    // 기존 기록의 수정/삭제는 클라이언트에서 허용하지 않습니다.
    match /leaderboard/{entryId} {
      allow read: if true;

      allow create: if request.resource.data.keys().hasAll(
          ['nickname', 'house', 'elapsedSeconds', 'solved', 'createdAt']
        )
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() > 0
        && request.resource.data.nickname.size() <= 20
        && request.resource.data.house is string
        && request.resource.data.elapsedSeconds is number
        && request.resource.data.elapsedSeconds >= 0
        && request.resource.data.solved is bool;

      allow update, delete: if false;
    }

    // 기숙사 배정 테스트 결과: 응시자 본인이 결과를 생성할 수 있고, 관리자 페이지가
    // 목록을 읽습니다. 배정(assignedHouse/assignedAt)만 이후에 갱신할 수 있고,
    // 그 외 필드는 생성 이후 변경할 수 없습니다.
    match /players/{playerId} {
      allow read: if true;

      allow create: if request.resource.data.keys().hasAll(
          ['nickname', 'testScores', 'computedHouse', 'assignedHouse', 'assignedAt', 'createdAt']
        )
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() > 0
        && request.resource.data.nickname.size() <= 20
        && request.resource.data.testScores is map
        && request.resource.data.computedHouse in ['flame', 'moonlight', 'earth', 'wind']
        && request.resource.data.assignedHouse == null
        && request.resource.data.assignedAt == null;

      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['assignedHouse', 'assignedAt'])
        && request.resource.data.assignedHouse in ['flame', 'moonlight', 'earth', 'wind'];

      allow delete: if false;
    }

    // 연회장 피드/댓글: 이 프로젝트는 아직 로그인(Firebase Auth) 없이 동작하므로
    // "작성자 본인만 수정 가능" 같은 진짜 신원 검증은 불가능합니다. 형식만
    // 검증하고, 수정/삭제 버튼 노출은 클라이언트(내 playerId 비교)에서만 막습니다.
    match /posts/{postId} {
      allow read: if true;

      allow create: if request.resource.data.keys().hasAll(
          ['authorPlayerId', 'authorNickname', 'title', 'content', 'allowComments']
        )
        && request.resource.data.authorNickname is string
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 60
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 2000
        && request.resource.data.allowComments is bool;

      allow update: if request.resource.data.title is string
        && request.resource.data.title.size() <= 60
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 2000
        && request.resource.data.allowComments is bool;

      allow delete: if true;

      match /comments/{commentId} {
        allow read: if true;

        allow create: if request.resource.data.keys().hasAll(
            ['authorPlayerId', 'authorNickname', 'content', 'secret']
          )
          && request.resource.data.authorNickname is string
          && request.resource.data.content is string
          && request.resource.data.content.size() > 0
          && request.resource.data.content.size() <= 500
          && request.resource.data.secret is bool;

        allow update: if request.resource.data.content is string
          && request.resource.data.content.size() > 0
          && request.resource.data.content.size() <= 500;

        allow delete: if true;
      }
    }

    // 조사 활동은 플레이어별 자유 탐색(로컬 저장)이라 이 문서 자체는 콘텐츠를
    // 담지 않습니다. 관리자가 그 날짜의 조사창을 잠그고 여는 상태(locked)만
    // 저장하고, 그 외 필드는 쓸 수 없습니다. 관리자의 즉흥 대사/증거 제시
    // 로그(adlibs)는 서브컬렉션으로 둡니다.
    match /sessions/{dayId} {
      allow read: if true;
      allow delete: if false;

      allow create, update: if request.resource.data.keys().hasOnly(['locked'])
        && request.resource.data.locked is bool;

      // 관리자의 즉흥 대사/상황 설명(Roll20 스타일 애드립)과 플레이어의 증거
      // 제시 로그입니다. 채팅 로그와 마찬가지로 추가만 가능하고 수정/삭제는 막습니다.
      match /adlibs/{adlibId} {
        allow read: if true;

        allow create: if request.resource.data.keys().hasAll(['kind', 'speaker', 'text'])
          && request.resource.data.kind in ['narration', 'evidence', 'chat', 'options']
          && request.resource.data.speaker is string
          && request.resource.data.speaker.size() <= 30
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 1000
          && (request.resource.data.kind == 'options' || request.resource.data.text.size() > 0)
          && (request.resource.data.kind != 'options'
            || (request.resource.data.options is list
              && request.resource.data.options.size() >= 1
              && request.resource.data.options.size() <= 5));

        allow update, delete: if false;
      }
    }

    // 기숙사 단체 대화: 같은 기숙사로 배정된 플레이어들이 실시간으로 나누는
    // 채팅입니다. 게시글과 마찬가지로 추가만 가능하고 수정/삭제는 막습니다.
    match /dormChats/{houseId} {
      allow read: if true;
      allow create, update, delete: if false;

      match /messages/{messageId} {
        allow read: if true;

        allow create: if request.resource.data.keys().hasAll(
            ['authorPlayerId', 'authorNickname', 'text']
          )
          && request.resource.data.authorNickname is string
          && request.resource.data.authorNickname.size() <= 20
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500;

        allow update, delete: if false;
      }
    }

    // 휴게시간 활동 공간(도서관 제외)의 잠금 상태입니다. 관리자가 열어야
    // 플레이어에게 보입니다. 형식만 검증하고, 노출 여부는 클라이언트에서
    // isAdmin으로 판단합니다.
    match /recessLocks/{roomId} {
      allow read: if true;
      allow delete: if false;

      allow create, update: if request.resource.data.keys().hasOnly(['locked'])
        && request.resource.data.locked is bool;
    }

    // 관리자가 보내는 전체 팝업 공지(교내 안내)입니다. 최신 한 건만 문서 하나에
    // 덮어써 저장하고, 각 플레이어 화면은 이 문서를 구독해 새 id가 오면 팝업으로 띄웁니다.
    match /announcements/{docId} {
      allow read: if true;
      allow delete: if false;

      allow create, update: if request.resource.data.keys().hasOnly(['id', 'text', 'sentAt'])
        && request.resource.data.id is string
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500
        && request.resource.data.sentAt is number;
    }

    // 퀴디치 경기장: 단일 방(room) 문서 하나에 좌석/보드/점수 등 전체 대국 상태를
    // 통째로 저장합니다. 상태가 매우 자주, 다양한 모양으로 바뀌므로(대기/진행/종료)
    // 필드 단위 검증 대신 status 값만 검증하고 나머지는 클라이언트 로직을 신뢰합니다.
    match /quidditch/{docId} {
      allow read: if true;
      allow delete: if false;

      allow create, update: if request.resource.data.status in ['waiting', 'playing', 'finished'];
    }

    // 금지된 숲 탐사: 단일 방(party) 문서 하나에 좌석(2~4)/스테이지/전투 상태를
    // 통째로 저장합니다. 퀴디치와 마찬가지로 상태 모양이 매우 다양해서 status
    // 값만 검증하고 나머지는 클라이언트 로직을 신뢰합니다.
    match /forest/{docId} {
      allow read: if true;
      allow delete: if false;

      allow create, update: if request.resource.data.status in ['lobby', 'exploring', 'event', 'combat', 'cleared', 'failed'];
    }

    // 약초 농장: 플레이어 1인당 문서 하나(슬롯/도감)를 저장하는 방치형 재배
    // 콘텐츠입니다. 문서 ID가 곧 playerId라 소유권 검증은 없지만(이 프로젝트에
    // 로그인이 없음), 최소한 모양은 검증합니다.
    match /herbFarms/{playerId} {
      allow read: if true;
      allow delete: if false;

      allow create, update: if request.resource.data.playerId is string
        && request.resource.data.slots is list
        && request.resource.data.dex is map;
    }

    // 알림 설정: 플레이어 1인당 문서 하나. 클라이언트가 토글마다 필드 하나씩
    // 부분 병합(merge)으로 쓰기 때문에, 매 쓰기마다 4개 필드가 전부 있으라고
    // 요구하면 첫 토글에서 막혀버립니다. 그래서 "존재하는 필드는 반드시
    // bool"만 검증합니다.
    match /notificationPrefs/{playerId} {
      allow read: if true;
      allow delete: if false;

      allow create, update: if
        (!('master' in request.resource.data) || request.resource.data.master is bool) &&
        (!('event' in request.resource.data) || request.resource.data.event is bool) &&
        (!('chat' in request.resource.data) || request.resource.data.chat is bool) &&
        (!('mention' in request.resource.data) || request.resource.data.mention is bool);
    }

    // 알림 센터: 웹앱이 열려 있는 동안 공지/피드/기숙사 대화/태그를 감지해
    // 만드는 인앱 알림 기록입니다(1단계 — 실제 모바일 OS 푸시는 별도
    // 인프라가 필요해 이후 단계). 문서 id 자체가 (playerId, type, targetId)
    // 조합의 고유 키라 같은 이벤트가 중복 생성되지 않습니다. 생성 이후에는
    // isRead만 바꿀 수 있습니다.
    match /notifications/{notifId} {
      allow read: if true;
      allow delete: if false;

      allow create: if request.resource.data.keys().hasAll(
          ['playerId', 'type', 'title', 'body', 'targetUrl', 'targetId', 'isRead', 'createdAt']
        )
        && request.resource.data.playerId is string
        && request.resource.data.type in ['POPUP', 'FEED', 'CHAT', 'MENTION']
        && request.resource.data.title is string
        && request.resource.data.body is string
        && request.resource.data.targetUrl is string
        && request.resource.data.targetId is string
        && request.resource.data.isRead is bool;

      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead'])
        && request.resource.data.isRead is bool;
    }

    // 탐문: 플레이어와 NPC 사이의 1:1 개인 채팅방입니다. NPC는 공용이지만
    // 대화방은 (playerId, npcId) 조합으로 개인마다 분리됩니다. 답변은 항상
    // 관리자가 직접 작성하며(AI 자동 응답 없음), 각 스레드에는 최신 메시지
    // 요약/상태(WAITING·ANSWERED)와 플레이어 읽음 여부만 저장합니다. 실제
    // 대화 내용은 메시지 서브컬렉션에 추가만 가능한 형태로 저장합니다.
    match /interrogationThreads/{threadId} {
      allow read: if true;
      allow delete: if false;

      allow create, update: if request.resource.data.playerId is string
        && request.resource.data.npcId is string
        && request.resource.data.status in ['WAITING', 'ANSWERED']
        && request.resource.data.lastSender in ['player', 'admin']
        && request.resource.data.playerUnread is bool;

      match /messages/{messageId} {
        allow read: if true;
        allow delete: if false;

        allow create: if request.resource.data.keys().hasAll(['sender', 'text', 'createdAt'])
          && request.resource.data.sender in ['player', 'admin']
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000;

        allow update: if false;
      }
    }
  }
}
